android_app {
    name: "DisconnectNotifierSettings",
    
    srcs: ["src/**/*.java"],
    resource_dirs: ["res"],

    package_name: "com.android.breminder.settings",

    static_libs: [
        "androidx.appcompat_appcompat",
        "com.google.android.material_material",
    ],

    platform_apis: true,
    privileged: true,
    
    certificate: "platform",

    required: [
        "privapp-permissions-breminder.xml",
        "default-permissions-breminder.xml",
    ],

    optimize: {
        enabled: true,
    },
}

prebuilt_etc {
    name: "privapp-permissions-breminder.xml",
    src: "privapp-permissions-breminder.xml",
    sub_dir: "permissions",
    filename_from_src: true,
}

prebuilt_etc {
    name: "default-permissions-breminder.xml",
    src: "default-permissions-breminder.xml",
    sub_dir: "default-permissions",
    filename_from_src: true,
}