<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="16dp"
    tools:context=".MainActivity">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/feature_title"
        android:textSize="20sp"
        android:textStyle="bold"
        android:layout_marginBottom="24dp"/>

    <!-- Toggle 1: Notificacao de Timeout -->
    <com.google.android.material.switchmaterial.SwitchMaterial
        android:id="@+id/switch_timeout_notifier"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/toggle_timeout_notifier_title"
        android:layout_marginBottom="8dp"
        android:textSize="16sp"/>

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/toggle_timeout_notifier_desc"
        android:layout_marginStart="16dp"
        android:layout_marginBottom="24dp"/>

    <!-- Toggle 2: Zona Segura WiFi (Placeholder) -->
    <com.google.android.material.switchmaterial.SwitchMaterial
        android:id="@+id/switch_safe_zone_wifi"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/toggle_safe_zone_title"
        android:layout_marginBottom="8dp"
        android:textSize="16sp"/>

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/toggle_safe_zone_desc"
        android:layout_marginStart="16dp"/>

</LinearLayout>